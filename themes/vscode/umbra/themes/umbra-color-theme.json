  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {"foreground": "#697271", "fontStyle": "italic"}
    },
    {
      "name": "Documentation comment",
      "scope": ["comment.block.documentation", "comment.line.documentation"],
      "settings": {"foreground": "#858A89", "fontStyle": "italic"}
    },
    {
      "name": "String",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {"foreground": "#CDA27C"}
    },
    {
      "name": "Template interpolation",
      "scope": ["punctuation.definition.template-expression"],
      "settings": {"foreground": "#C78995"}
    },
    {
      "name": "Regular expression",
      "scope": ["string.regexp"],
      "settings": {"foreground": "#C78995"}
    },
    {
      "name": "String escape",
      "scope": ["constant.character.escape"],
      "settings": {"foreground": "#A9B4C8"}
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {"foreground": "#D0B07C"}
    },
    {
      "name": "Boolean and language constants",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nan",
        "constant.language.infinity"
      ],
      "settings": {"foreground": "#83B89A"}
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {"foreground": "#C78995", "fontStyle": "bold"}
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": {"foreground": "#C78995"}
    },
    {
      "name": "Type, constant and constructor",
      "scope": [
        "entity.name.type",
        "entity.name.namespace",
        "entity.name.scope",
        "support.type",
        "support.class",
        "support.variable",
        "constant",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {"foreground": "#A9B4C8"}
    },
    {
      "name": "Function, method and component",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "entity.name.function.constructor",
        "support.function",
        "variable.function",
        "support.class.component",
        "meta.function-call"
      ],
      "settings": {"foreground": "#B79BDD"}
    },
    {
      "name": "Constructor invocation without semantic tokens",
      "scope": ["meta.new.expr entity.name.type"],
      "settings": {"foreground": "#B79BDD"}
    },
    {
      "name": "Decorator and annotation",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "entity.other.attribute"
      ],
      "settings": {"foreground": "#9D7FD1"}
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": {"foreground": "#CDA27C"}
    },
    {
      "name": "Tag punctuation",
      "scope": ["punctuation.definition.tag"],
      "settings": {"foreground": "#858A89"}
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": {"foreground": "#B79BDD"}
    },
    {
      "name": "Object key",
      "scope": ["meta.object-literal.key", "string.unquoted.label"],
      "settings": {"foreground": "#CDA27C"}
    },
    {
      "name": "CSS property",
      "scope": ["support.type.property-name.css", "meta.property-name.css"],
      "settings": {"foreground": "#B4BEC0"}
    },
    {
      "name": "CSS value",
      "scope": ["support.constant.property-value.css", "meta.property-value.css"],
      "settings": {"foreground": "#CDA27C"}
    },
    {
      "name": "Data key",
      "scope": [
        "meta.structure.dictionary.key",
        "meta.mapping.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json"
      ],
      "settings": {"foreground": "#A9B4C8"}
    },
    {
      "name": "Property and member variable",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name",
        "entity.other.label"
      ],
      "settings": {"foreground": "#B4BEC0"}
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other", "variable.language", "meta.embedded"],
      "settings": {"foreground": "#C5C7C5"}
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": {"foreground": "#B4BEC0", "fontStyle": "italic"}
    },
    {
      "name": "This, self and super",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {"foreground": "#9D7FD1"}
    },
    {
      "name": "Special variable",
      "scope": ["variable.other.special", "variable.language.special"],
      "settings": {"foreground": "#9D7FD1"}
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition"
      ],
      "settings": {"foreground": "#7E8787"}
    },
    {
      "name": "Bracket",
      "scope": [
        "punctuation.section",
        "punctuation.definition.block",
        "meta.brace",
        "meta.bracket"
      ],
      "settings": {"foreground": "#858A89"}
    },
    {
      "name": "Markup literal",
      "scope": ["markup.raw", "string.other.link", "markup.code"],
      "settings": {"foreground": "#B892B7"}
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {"foreground": "#C5C7C5", "fontStyle": "bold"}
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {"foreground": "#C5C7C5", "fontStyle": "bold"}
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {"foreground": "#C5C7C5", "fontStyle": "italic"}
    },
    {
      "name": "Markup strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": {"foreground": "#858A89", "fontStyle": "strikethrough"}
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": {"foreground": "#9AB7B0"}
    },
    {
      "name": "Markup inserted",
      "scope": ["markup.inserted"],
      "settings": {"foreground": "#75A88A"}
    },
    {
      "name": "Markup deleted",
      "scope": ["markup.deleted"],
      "settings": {"foreground": "#C9858D"}
    },
    {
      "name": "Markup changed",
      "scope": ["markup.changed"],
      "settings": {"foreground": "#B9A16B"}
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {"foreground": "#E0A0A7"}
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {"foreground": "#B9A16B", "fontStyle": "italic underline"}
    }
  ],
  "semanticTokenColors": {
    "keyword": {"foreground": "#C78995", "bold": true},
    "modifier": "#C78995",
    "operator": "#C78995",
    "type": "#A9B4C8",
    "class": "#B79BDD",
    "struct": "#A9B4C8",
    "enum": "#A9B4C8",
    "enumMember": "#A9B4C8",
    "interface": "#A9B4C8",
    "typeParameter": "#A9B4C8",
    "namespace": "#A9B4C8",
    "constant": "#A9B4C8",
    "function": "#B79BDD",
    "function.declaration": {"foreground": "#B79BDD", "bold": true},
    "method": "#B79BDD",
    "method.declaration": {"foreground": "#B79BDD", "bold": true},
    "constructor": "#B79BDD",
    "decorator": "#9D7FD1",
    "string": "#CDA27C",
    "number": "#D0B07C",
    "boolean": "#83B89A",
    "regexp": "#C78995",
    "property": "#B4BEC0",
    "property.declaration": "#CDA27C",
    "event": "#B4BEC0",
    "variable": "#C5C7C5",
    "parameter": {"foreground": "#B4BEC0", "italic": true},
    "selfKeyword": "#9D7FD1",
    "comment": {"foreground": "#697271", "italic": true},
    "comment.documentation": {"foreground": "#858A89", "italic": true},
    "attribute": "#B79BDD",
    "label": "#B4BEC0",
    "macro": "#C78995",
    "lifetime": "#A9B4C8",
    "escapeSequence": "#A9B4C8",
    "formatSpecifier": "#A9B4C8",
    "*.readonly": {"foreground": "#A9B4C8"},
    "*.static": {"foreground": "#A9B4C8"},
    "*.deprecated": {"foreground": "#B9A16B", "italic": true}
  }
}
