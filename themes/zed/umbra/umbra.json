{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Umbra",
  "author": "Monochrome Themes",
  "themes": [
    {
      "name": "Umbra",
      "appearance": "dark",
      "style": {
        "accents": ["#9AB7B0", "#B79BDD", "#CDA27C", "#C78995", "#83B89A"],
        "background": "#101111",
        "border": "#252727",
        "border.disabled": "#1A1C1C",
        "border.focused": "#9AB7B0",
        "border.selected": "#A9B4C8",
        "border.transparent": "#00000000",
        "border.variant": "#1D2020",
        "editor.active_line.background": "#191C1C",
        "editor.background": "#101111",
        "editor.foreground": "#C5C7C5",
        "editor.gutter.background": "#101111",
        "editor.highlighted_line.background": "#0E1010",
        "editor.indent_guide": "#1D2020",
        "editor.indent_guide_active": "#3B4242",
        "editor.invisible": "#3B4242",
        "editor.line_number": "#555B5A",
        "editor.active_line_number": "#AEB9BC",
        "element.active": "#252727",
        "element.background": "#101111",
        "element.disabled": "#101111",
        "element.hover": "#191C1C",
        "element.selected": "#252727",
        "elevated_surface.background": "#101111",
        "error": "#C9858D",
        "error.background": "#291A1D",
        "error.border": "#A97882",
        "ghost_element.active": "#191C1C",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#101111",
        "hint": "#6CAFC7",
        "icon": "#AEB9BC",
        "icon.accent": "#9AB7B0",
        "icon.disabled": "#555B5A",
        "icon.muted": "#858A89",
        "info": "#9AB7B0",
        "link_text.hover": "#9AB7B0",
        "modified": "#B9A16B",
        "modified.background": "#1B1B1B",
        "pane.focused_border": "#3B4242",
        "panel.background": "#101111",
        "panel.focused_border": "#00A6C7",
        "predictive": "#697271",
        "scrollbar.thumb.background": "#3B4242",
        "scrollbar.thumb.hover_background": "#555B5A",
        "scrollbar.track.background": "#101111",
        "search.match_background": "#303030",
        "status_bar.background": "#101111",
        "success": "#75A88A",
        "success.background": "#17251D",
        "surface.background": "#101111",
        "tab.active_background": "#101111",
        "tab.inactive_background": "#101111",
        "tab_bar.background": "#101111",
        "terminal.background": "#101111",
        "terminal.foreground": "#C5C7C5",
        "terminal.bright_foreground": "#E3E6E3",
        "terminal.dim_foreground": "#858A89",
        "terminal.ansi.background": "#101111",
        "terminal.ansi.black": "#101111",
        "terminal.ansi.bright_black": "#555B5A",
        "terminal.ansi.red": "#C9858D",
        "terminal.ansi.bright_red": "#E0A0A7",
        "terminal.ansi.green": "#75A88A",
        "terminal.ansi.bright_green": "#9BC6A8",
        "terminal.ansi.yellow": "#B9A16B",
        "terminal.ansi.bright_yellow": "#D7BF88",
        "terminal.ansi.blue": "#8997A8",
        "terminal.ansi.bright_blue": "#A9B4C8",
        "terminal.ansi.magenta": "#9B6CFF",
        "terminal.ansi.bright_magenta": "#BE9FFF",
        "terminal.ansi.cyan": "#9AB7B0",
        "terminal.ansi.bright_cyan": "#B9D2C9",
        "terminal.ansi.white": "#C5C7C5",
        "terminal.ansi.bright_white": "#FFFFFF",
        "text": "#C5C7C5",
        "text.accent": "#9AB7B0",
        "text.disabled": "#555B5A",
        "text.muted": "#858A89",
        "syntax": {
          "attribute": {"color": "#B79BDD"},
          "boolean": {"color": "#83B89A"},
          "comment": {"color": "#697271", "font_style": "italic"},
          "comment.doc": {"color": "#858A89", "font_style": "italic"},
          "constant": {"color": "#A9B4C8"},
          "constructor": {"color": "#A9B4C8"},
          "embedded": {"color": "#C5C7C5"},
          "function": {"color": "#B79BDD"},
          "function.method": {"color": "#B79BDD"},
          "keyword": {"color": "#C78995", "font_weight": 600},
          "label": {"color": "#B4BEC0"},
          "link_text": {"color": "#9AB7B0"},
          "number": {"color": "#D0B07C"},
          "operator": {"color": "#C78995"},
          "property": {"color": "#B4BEC0"},
          "punctuation": {"color": "#7E8787"},
          "string": {"color": "#CDA27C"},
          "string.escape": {"color": "#A9B4C8"},
          "tag": {"color": "#CDA27C"},
          "text.literal": {"color": "#B892B7"},
          "title": {"color": "#C5C7C5", "font_weight": 600},
          "type": {"color": "#A9B4C8"},
          "type.builtin": {"color": "#A9B4C8"},
          "variable": {"color": "#C5C7C5"},
          "variable.member": {"color": "#B4BEC0"},
          "variable.special": {"color": "#9D7FD1"}
        }
      }
    }
  ]
}
